# ========================================================
# OMADA SDN CONTROLLER OPEN API CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your controller settings.
# NEVER commit your actual .env file to version control.
# ========================================================

# Base URL for the Omada Controller (typically port 8043)
OMADA_URL=https://omada.example.com:8043

# Open API Client Credentials (Global View > Settings > Platform Integration > Open API)
# Mode must be set to "Client" (not "Gateway")
OMADA_CLIENT_ID=your_omada_client_id_here
OMADA_CLIENT_SECRET=your_omada_client_secret_here

# Controller ID and Target Site ID (Optional: auto-discovered if omitted)
OMADA_ID=your_omada_controller_id_here
OMADA_SITE_ID=your_target_site_id_here

# Set to 1 to bypass self-signed TLS certificate checks for local controller
OMADA_INSECURE_TLS=1
